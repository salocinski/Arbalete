{
  "name": "arbalete-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype de navigateur desktop inspiré d'Arc",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/salocinski/arbalete.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "preview:web": "vite preview --config vite.web.config.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node scripts/test-unitaire.mjs",
    "test:smoke": "electron-vite build && playwright test",
    "dist": "electron-vite build && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.73.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
